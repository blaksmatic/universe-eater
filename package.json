{
  "name": "universe-eater",
  "version": "0.3.0",
  "private": true,
  "scripts": {
    "build": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --sourcemap && node build-standalone.js",
    "watch": "esbuild src/main.ts --bundle --outfile=dist/bundle.js --sourcemap --watch",
    "build:wx": "esbuild src/main.ts --bundle --format=cjs --target=es2017 --alias:three=./wx/empty-three --define:document=__doc --define:window=__win --define:navigator=__nav --define:getComputedStyle=__getComputedStyle --outfile=wx/bundle.js",
    "watch:wx": "esbuild src/main.ts --bundle --format=cjs --target=es2017 --alias:three=./wx/empty-three --define:document=__doc --define:window=__win --define:navigator=__nav --define:getComputedStyle=__getComputedStyle --outfile=wx/bundle.js --watch",
    "serve": "npx serve . -p 3000",
    "dev": "npm run build && concurrently \"npm run watch\" \"npm run serve\"",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/playtest.mjs all",
    "test:smoke": "node scripts/playtest.mjs smoke",
    "test:qa": "node scripts/qa-edge.mjs",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/three": "^0.180.0",
    "concurrently": "^9.0.0",
    "esbuild": "^0.25.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.56.1",
    "typescript": "^6.0.2",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "three": "^0.180.0"
  }
}
